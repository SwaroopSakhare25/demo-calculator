pipeline {
    agent any

    tools {
        maven 'mvn'   // Name from Manage Jenkins → Global Tool Configuration
    }

    environment {
        // Match these to your Jenkins setup
        SONARQUBE_SERVER = 'SonarQubeServer'             // Name configured under Manage Jenkins → System → SonarQube servers
        SONAR_AUTH_TOKEN  = credentials('sonarqube-token-1')  // ID of your SonarCloud token in Jenkins Credentials
    }

    stages {
        stage('Checkout') {
            steps {
                echo '🔹 Checking out source code...'
                checkout scm
            }
        }

        stage('Build WAR') {
            steps {
                echo '🔹 Building the WAR file with Maven...'
                sh 'mvn clean package -DskipTests=false'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '🔹 Running SonarCloud analysis...'
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    // ✅ FIXED: single-line safe command + disable JS/CSS/HTML analysis
                    sh 'mvn sonar:sonar -Dsonar.projectKey=calculator-webapp -Dsonar.organization=swaroop-demo -Dsonar.host.url=https://sonarcloud.io -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.html.file.suffixes=- -Dsonar.javascript.enabled=false -Dsonar.css.enabled=false -Dsonar.exclusions="**/*.html"'
                }
            }
        }

        stage('Verify Sonar Upload') {
            steps {
                echo '🔹 Verifying if report-task.txt was created...'
                sh 'ls -l target/sonar || echo "⚠️  Sonar report-task.txt not found (check Sonar logs or organization key)."'
            }
        }
    }

    post {
        success {
            echo '✅ Build and SonarCloud analysis completed successfully!'
        }
        failure {
            echo '❌ Build or SonarCloud analysis failed!'
        }
    }
}
