pipeline {
    agent any

    tools {
        maven 'mvn'
    }

    environment {
        // Change these to match your Jenkins setup
        SONARQUBE_SERVER = 'SonarQubeServer'           // Name configured in Jenkins -> Manage Jenkins -> SonarQube servers
        SONAR_AUTH_TOKEN  = credentials('sonarqube-token-1')  // Jenkins credential ID for SonarQube token
    }

    stages {
        stage('Checkout') {
            steps {
                echo '🔹 Checking out source code...'
                checkout scm
            }
        }

        stage('Build WAR') {
            steps {
                echo '🔹 Building the WAR file with Maven...'
                sh 'mvn clean package -DskipTests=false'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '🔹 Running SonarQube analysis...'
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    sh """
                        mvn sonar:sonar 
                          -Dsonar.html.file.suffixes=- 
                          -Dsonar.organization=swaroop-demo                     
                          -Dsonar.projectKey=calculator-webapp 
                          -Dsonar.organization=swaroop-demo 
                          -Dsonar.host.url=https://sonarcloud.io 
                          -Dsonar.login=$SONAR_AUTH_TOKEN 
                          -Dsonar.javascript.enabled=false 
                          -Dsonar.css.enabled=false 
                          -Dsonar.exclusions=**/*.html
                    """
                }
            }
        }
    }

    post {
        success {
            echo '✅ Build and SonarQube analysis completed successfully!'
        }
        failure {
            echo '❌ Build or SonarQube analysis failed!'
        }
    }
}
